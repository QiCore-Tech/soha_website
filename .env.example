# Feishu Careers build-time sync
# Configure all four variables together in Vercel. Never expose the secret to browser code.
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=replace_in_vercel_only
FEISHU_CAREERS_BASE_TOKEN=replace_with_base_token
FEISHU_CAREERS_TABLE_ID=tblxxxxxxxxxxxxxx

# Public Feishu form URL used by every application button on /careers.
CAREERS_APPLICATION_FORM_URL=https://example.feishu.cn/share/base/replace_with_form_share_token

# Server-only variables used by the Base workflow to create Feishu screening tasks.
FEISHU_RECRUITMENT_WEBHOOK_SECRET=replace_in_vercel_only
FEISHU_RECRUITMENT_ASSIGNEE_OPEN_ID=ou_xxxxxxxxxxxxxxxx

# Beta intake uses a server-only app with record-create access to its Base.
FEISHU_BETA_APP_ID=replace_with_beta_app_id
FEISHU_BETA_APP_SECRET=replace_in_vercel_only
FEISHU_BETA_BASE_TOKEN=replace_with_beta_base_token
FEISHU_BETA_TABLE_ID=replace_with_beta_table_id
