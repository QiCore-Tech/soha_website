{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "functions": {
    "api/*.js": {
      "maxDuration": 10
    }
  },
  "cleanUrls": false,
  "rewrites": [
    { "source": "/about", "destination": "/about.html" },
    { "source": "/news", "destination": "/news.html" },
    { "source": "/careers", "destination": "/careers.html" },
    { "source": "/relax", "destination": "/relax.html" }
  ],
  "redirects": [
    {
      "source": "/oyscat",
      "destination": "https://www.oyscat.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.qicore.ai"
        }
      ],
      "destination": "https://qicore.ai/:path*",
      "permanent": true
    }
  ]
}
