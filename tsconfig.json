{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/i18n/*": [
        "./i18n/*"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    ".next-carousel-check/types/**/*.ts",
    ".next-preview/types/**/*.ts",
    ".next.dev-3002/types/**/*.ts",
    ".next/types/**/*.ts",
    "i18n/**/*.ts",
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next.dev-verify/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
