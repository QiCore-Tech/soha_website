{
  "name": "soha-website",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3007",
    "dev:3007": "QICORE_DEV_DIST_DIR=.next.dev-3002 next dev --hostname 0.0.0.0 --port 3007",
    "build": "next build",
    "start": "node src/scripts/local-preview.mjs",
    "preview": "node src/scripts/local-preview.mjs",
    "test": "npm run test:e2e",
    "test:e2e": "node --test --test-concurrency=1 src/tests/e2e/homepage.test.mjs",
    "test:e2e:static": "QICORE_E2E_MODE=static node --test --test-concurrency=1 src/tests/e2e/*.test.mjs",
    "test:e2e:smoke": "QICORE_E2E_MODE=static node --test --test-concurrency=1 src/tests/e2e/static-smoke.test.mjs",
    "test:e2e:ci": "npm run build && npm run test:preview && npm run test:e2e:static",
    "test:preview": "node --test src/tests/local-preview.test.mjs",
    "test:perf": "node src/tests/perf/runtime-benchmark.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.49.0",
    "motion": "^14.1.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swiper": "^14.3.0",
    "three": "^0.174.0",
    "xgplayer": "^3.0.26"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.174.0",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.59.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.28",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.0"
  }
}
